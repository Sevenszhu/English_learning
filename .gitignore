# ==========================================
# 操作系统相关 (Operating System)
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ==========================================
# C / C++ 相关
# ==========================================
# 编译产物
*.o
*.obj
*.out
*.exe
*.so
*.dll
*.dylib

# 构建目录
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/

# IDE/编辑器配置 (VS Code, Visual Studio)
.vscode/
.vs/
*.sln
*.vcxproj
*.user

# ==========================================
# MATLAB 相关
# ==========================================
*.asv  # 自动保存文件
*.m~   # 备份文件
*.mex* # 编译后的二进制文件
*.slxc # Simulink 缓存
*.log
# 如果你不希望同步数据文件，可以取消注释下面一行
# *.mat

# ==========================================
# LaTeX 相关
# ==========================================
# 核心中间文件
*.aux
*.log
*.toc
*.out
*.nav
*.snm
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.pdfsync

# 各种宏包产生的临时文件
*.thm
*.pre
*.bcf
*.run.xml
*.lof
*.lot
*.maf
*.mtc
*.mtc0
*.pyg

# 最终产物 (可选：如果你希望把 PDF 留在 Git 里，请注释掉下面这行)
# *.pdf


# ==========================================
# 其他通用
# ==========================================
.cache/
*.tmp
*.bak
# TeXmacs 自动生成的备份文件（非常重要，必须忽略）
*~
.#*

# 导出为 PDF 时生成的临时文件
*.aux
*.log
*.out
*.toc

# 如果你导出了 PDF，但不想把大文件传到 Git（可选）
# 如果你想在 Git 里保留 PDF 成果，可以把下面这行删掉
#*.pdf
*.raw
# 操作系统自带的垃圾文件
.DS_Store
Thumbs.db
# ==========================================
# JLCEDA Pro (嘉立创EDA专业版)
# ==========================================

# 缓存目录
cache/
Cache/
temp/
Temp/

# 自动保存/备份
*.bak
*.backup
*.autosave

# 锁文件
*.lock

# 制造输出文件
gerber/
Gerber/
Output/
fabrication/
production/

# BOM导出
bom/
BOM/

# SMT贴片坐标
*.pos
*.cpl
*.xy

# 导出表格
*.csv

# 导出图片
*.png
*.jpg
*.jpeg

# 导出PDF（如果你的PDF是论文/文档，请不要开启）
# *.pdf

# Generated LaTeX build directory (sources live in latex/).
build/

# Source image used by the Du Bois chapter.
!reading_texts/assets/
!reading_texts/assets/*.jpg

# Local Python environments and generated bytecode.
.venv/
__pycache__/
*.pyc
